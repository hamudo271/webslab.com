{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "autoPort": true
    },
    {
      "name": "admin-verify",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "ADMIN_PASSWORD=verify-test-pass ADMIN_JWT_SECRET=verify-test-secret-verify-test-secret pnpm dev -p 3456"
      ],
      "port": 3456
    }
  ]
}
